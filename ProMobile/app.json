{
  "expo": {
    "name": "WillFlow",
    "slug": "willflow",
    "description": "Rotina diária gamificada: tarefas por categoria, pontos, meta diária, sequência e lembretes.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "promobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0E1A",
    "ios": {
      "bundleIdentifier": "com.willian.promobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.willian.promobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A0E1A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22D3EE"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O WillFlow acessa suas fotos só para você escolher a foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a46b5a67-9412-4340-bbf5-f4b72a6f9ce5"
      }
    }
  }
}
